---
const {fullName, title, intro = []} = Astro.props
---
<div class='flex-1'>
  <h1 class='text-4xl font-bold mb-4'>
    Hello, I'm <span class='text-accent'>{fullName}</span>
  </h1>
  {title && <p class='text-xl text-gray-600 mb-4'>{title}</p>}
  {intro.map((paragraph: string) => (
    <p
      class='text-lg mb-6 [&_a]:text-sky-700 [&_a]:no-underline [&_a]:transition-colors [&_a:hover]:text-sky-600'
      set:html={paragraph}
    />
  ))}
</div>
