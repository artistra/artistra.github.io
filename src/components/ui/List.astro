---
interface Props {
  listTitle: string;
  listItems: {
    title: string;
    description: string;
    link?: string;
  }[];
}
const {listTitle, listItems} = Astro.props
---
<h2 class="text-2xl font-bold mb-6">{listTitle}</h2>
<div class="grid gap-6 mb-12">
  {
    listItems.map((item) => (
      <div class="p-6 bg-base-200 rounded-xl text-base-content">
        {item.link
          ? (
            <a href={item.link} class="block no-underline hover:text-accent transition-colors duration-200">
              <h3 class="text-xl font-semibold mb-3">{item.title}</h3>
            </a>
          )
          : <h3 class="text-xl font-semibold mb-3">{item.title}</h3>
        }
        <p>{item.description}</p>
        {item.link && (
          <div class="card-actions justify-end mt-4">
            <a
              href={item.link}
              class="btn btn-sm btn-accent theme-aware-accent-button"
            >
              Read More
            </a>
          </div>
        )}
      </div>
    ))
  }
</div>
